	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="client_id" class="java.lang.Integer"/>
	<parameter name="company_id" class="java.lang.Integer"/>
	<parameter name="start_date" class="java.lang.String">
		<defaultValueExpression><![CDATA[java.sql.Timestamp.valueOf("2011-02-28 00:00:00")]]></defaultValueExpression>
	</parameter>
	<parameter name="end_date" class="java.lang.String">
		<defaultValueExpression><![CDATA[java.sql.Timestamp.valueOf("2011-02-28 00:00:00")]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT opn.value, opn.name, balancedr_open, balancecr_open, balancedr_cur, balancecr_cur, balancedr_close, balancecr_close,
	(SELECT cl.clientname FROM (SELECT cl.name clientname FROM clients cl WHERE cl.id = $P{client_id}) cl) as clientname,
	(SELECT cm.companyname FROM (SELECT cm.name companyname FROM companies cm WHERE cm.id = $P{company_id}) cm) as companyname
	
FROM

/* Opening Balance */

( 	SELECT account_id, value, name, CASE WHEN balance > 0  THEN ABS(balance) ELSE 0 END balancedr_open,
	CASE WHEN balance < 0  THEN ABS(balance) ELSE 0 END balancecr_open

FROM

(SELECT tr.account_id, (sum(tr.debit) - sum(tr.credit)) balance

FROM account_transactions tr

WHERE tr.company_id = $P{company_id} AND tr.transaction_date < $P{start_date}

GROUP BY tr.account_id)amt

RIGHT JOIN

(SELECT act.id, act.code value, act.name

FROM accounts act

WHERE act.company_id = $P{company_id}

ORDER BY act.code)acct

ON amt.account_id = acct.id) opn

LEFT JOIN

/* Current Balance */

(SELECT account_id, value, name, CASE WHEN balance > 0 THEN ABS(balance) ELSE 0 END balancedr_cur, 	CASE WHEN balance < 0  THEN ABS(balance) ELSE 0 END balancecr_cur


FROM

(SELECT tr.account_id,(sum(tr.debit) - sum(tr.credit)) balance

FROM account_transactions tr

WHERE  tr.company_id = $P{company_id} AND tr.transaction_date BETWEEN $P{start_date} AND $P{end_date}

GROUP BY tr.account_id)amt

LEFT JOIN

(SELECT act.id, act.code value, act.name

FROM accounts act

WHERE act.company_id = $P{company_id}

ORDER BY act.code)acct

ON amt.account_id = acct.id) cur


ON opn.account_id = cur.account_id


LEFT JOIN


/* Closing Balance */

(SELECT account_id, value, name, CASE WHEN balance > 0 THEN ABS(balance) ELSE 0 END balancedr_close, 	CASE WHEN balance < 0  THEN ABS(balance) ELSE 0 END balancecr_close


FROM

(SELECT tr.account_id,(sum(tr.debit) - sum(tr.credit)) balance

FROM account_transactions tr

WHERE  tr.company_id = $P{company_id}  AND tr.transaction_date <= $P{end_date}

GROUP BY tr.account_id)amt

RIGHT JOIN

(SELECT act.id, act.code value, act.name

FROM accounts act

WHERE act.company_id = $P{company_id}

ORDER BY act.code)acct

ON amt.account_id = acct.id) close


ON opn.account_id = close.account_id


/* OverAll Query */

/* WHERE (balancedr_open+balancedr_cur+balancedr_close) - (balancecr_open+balancecr_cur+balancecr_close) != 0 */

ORDER BY value]]>
	</queryString>
